# Frontend environment variables
# Copy to .env.local and fill in values for your deployment.

# ── Search region for the Excavation Planner city-search ──────────────────────
# Controls the Nominatim geographic bias. Examples:
#   VITE_SEARCH_REGION=Tamil Nadu, India
#   VITE_SEARCH_REGION=Maharashtra, India
#   VITE_SEARCH_REGION=India          (searches all of India — default)
#   VITE_SEARCH_REGION=               (no bias — global search)
VITE_SEARCH_REGION=India

# ── Backend API URL ────────────────────────────────────────────────────────────
# Only set this if you are deploying the frontend separately from the backend.
# When using the Vite dev proxy (default), leave this empty.
VITE_API_BASE=
