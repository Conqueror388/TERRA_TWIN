PORT=4000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production (e.g. https://your-app.com).
# Defaults to http://localhost:5173 for local dev if omitted.
CORS_ORIGIN=http://localhost:5173

# ── Firebase / Firestore (optional) ──────────────────────────────────────────
# Omit both to use in-memory storage (accounts reset on restart).
# Set ONE of the following:
#   FIREBASE_SERVICE_ACCOUNT = the full JSON content of your service account key
#   GOOGLE_APPLICATION_CREDENTIALS = path to the service account JSON file
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Gemini AI (optional) ──────────────────────────────────────────────────────
# Omit to use the canned fallback explanation instead of live Gemini calls.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# After filling in the above, verify integrations work:
#   npm run check-integrations
# See CREDENTIALS.md for step-by-step setup instructions.
